[Unit]
Description=OpenTelemetry Collector Agent
After=network.target

[Service]
Type=simple
ExecStart={{ otel_agent_installation_dir }}/{{ otel_agent_executable }} --config={{ otel_agent_config_dir }}/config.yml
User=root
Group=root
Restart=on-failure
StateDirectory={{ otel_agent_service_name }}

[Install]
WantedBy=multi-user.target
